{
  "id": "com.autodeck.custom_stack_bar",
  "name": "Financial Position Stack Bar",
  "version": "1.0.0",
  "description": "A custom widget showing the financial position of assets and liabilities.",
  "newInstancePrefix": "financialPositionStackBar",
  "vendor": "autodeck.com",
  "eula": "autodeck.com",
  "license": "MIT",
  "icon": "https://cdn.jsdelivr.net/gh/JSKowontan/financialPositionStackBar@1.2.0/icon.png",
  "imports": [
    "datasource",
    "planning-model"
  ],
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-autodeck-custom_stack_bar",
      "url": "https://cdn.jsdelivr.net/gh/JSKowontan/financialPositionStackBar@1.2.0/financialPositionStackBar_2.js",
      "integrity": "sha256-WEgjTxC8HZEmDwebICg7YDQhg0tMZij+CmXBFdi8F5o=",
      "ignoreIntegrity": false
    },
    {
      "kind": "builder",
      "tag": "com-autodeck-custom_stack_bar-builder",
      "url": "https://cdn.jsdelivr.net/gh/JSKowontan/financialPositionStackBar@1.2.0/financialPositionStackBar_2.js",
      "integrity": "sha256-WEgjTxC8HZEmDwebICg7YDQhg0tMZij+CmXBFdi8F5o=",
      "ignoreIntegrity": false
    }
  ],
  "properties": {
    "tableTitle": {
      "description": "Name of Chart",
      "type": "string",
      "default": "Financial Position (Current/Non-Current)"
    },
    "searching": {
      "type": "boolean",
      "default": true
    }
  },
  "methods": {
    "setChartData": {
      "description": "Sets the chart data.",
      "parameters": [
        {
          "name": "RecordsArray",
          "type": "Selection[]"
        }
      ]
    }
  },
  "events": {}
}



